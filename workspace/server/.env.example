# ===================================================================
# ReciclaJá API — Variáveis de ambiente
# ===================================================================
# Copie este arquivo para .env e preencha com valores REAIS:
#   cp .env.example .env
#
# O arquivo .env NÃO é versionado no git (está no .gitignore).
# NUNCA commite senhas ou segredos reais neste repositório.
# ===================================================================

# ── Servidor ────────────────────────────────────────────────────────
# Porta em que a API escuta (padrão: 3001)
PORT=3001

# ── Segurança ───────────────────────────────────────────────────────
# Chave secreta usada para assinar os tokens JWT.
# Gere uma chave forte com um dos comandos abaixo e cole aqui:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#   openssl rand -hex 48
# OBRIGATÓRIA em produção (o servidor não inicia sem ela).
JWT_SECRET=troque-esta-chave-por-uma-aleatoria-de-96-caracteres

# ── Administrador (seed inicial) ────────────────────────────────────
# Usados APENAS na primeira execução, para criar a conta de admin
# no banco de dados (se ela ainda não existir).
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=troque-esta-senha
ADMIN_NAME=Administrador

# ── Verificação de conta por e-mail (SMTP/Nodemailer) ───────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Verificação de conta por SMS (Twilio) ───────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
